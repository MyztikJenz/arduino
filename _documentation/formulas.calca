# Ohm's law
v = I * r

# voltage divider
https://learn.sparkfun.com/tutorials/voltage-dividers

R1 is the resistor closest to vIn, R2 is closer to ground. 

vIn = 5 # in volts
R1 = 2200 # in ohms
R2 = 4700
vOut = vIn * (R2 / (R1 + R2))
vOut => 3.4058

Simplifications: 
	• if R1 and R2 are equal, voltage is divided in half regardless of resistance.
	• if R2 is significantly larger than R1, vOut will nearly be vIn
	• if R1 is significantly larger, vOut will be nearly zero

# 555 timer
http://www.ti.com/lit/ds/symlink/lm555.pdf

###helpful constants (opt+z for Ω, opt+m for µ)
MΩ = 1
kΩ = 0.001
Ω  = 0.000001
mΩ = 0.000000001

 # normalized to µF being 1 
mF = 1000			# millifarad
µF = 1			# microfarad
nF = 0.001		# nanofarad
pF = 0.000001	# picofarad

Astable config
capacitance 	= 680pF 	# in μF (microfarads)
chargeRes   	= 10kΩ  	# in MΩ (megohms)
dischargeRes	= 5MΩ	# in MΩ

outputHigh = 0.693 * (chargeRes + dischargeRes) * capacitance
outputLow = 0.693 * dischargeRes * capacitance
frequency = 1.443 / ((chargeRes + 2 * dischargeRes) * capacitance)
# measure of one timing cycle
period = outputHigh + outputLow
# Ratio of time the timer is on for the period
dutyCycle = 100 * outputHigh / period

outputHigh (sec)	=> 0.0024
outputLow (sec) 	=> 0.0024
frequency (Hz) 	=> 211.9939
period (sec) 		=> 0.0047
dutyCycle (%) 		=> 50.05




